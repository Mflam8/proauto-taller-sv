{
  "name": "Cotizacion",
  "type": "object",
  "properties": {
    "numero_cotizacion": {
      "type": "string",
      "description": "Número único de cotización"
    },
    "cliente_id": {
      "type": "string",
      "description": "ID del cliente"
    },
    "vehiculo_id": {
      "type": "string",
      "description": "ID del vehículo"
    },
    "servicios": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "servicio_id": {
            "type": "string"
          },
          "nombre": {
            "type": "string"
          },
          "descripcion": {
            "type": "string"
          },
          "precio": {
            "type": "number"
          }
        }
      },
      "description": "Lista de servicios cotizados"
    },
    "subtotal": {
      "type": "number",
      "description": "Subtotal de la cotización"
    },
    "descuento": {
      "type": "number",
      "default": 0,
      "description": "Descuento aplicado"
    },
    "total": {
      "type": "number",
      "description": "Total de la cotización"
    },
    "estado": {
      "type": "string",
      "enum": [
        "Pendiente",
        "Aprobada",
        "Rechazada",
        "Vencida"
      ],
      "default": "Pendiente",
      "description": "Estado de la cotización"
    },
    "fecha_aprobacion": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha de aprobación"
    },
    "metodo_aprobacion": {
      "type": "string",
      "enum": [
        "Digital",
        "Física"
      ],
      "description": "Método de aprobación"
    },
    "notas": {
      "type": "string",
      "description": "Notas adicionales"
    },
    "vigencia_dias": {
      "type": "number",
      "default": 15,
      "description": "Días de vigencia"
    },
    "legacy_quote_id": {
      "type": "string",
      "description": "ID del presupuesto en sistema anterior (DBF)"
    },
    "legacy_customer_id": {
      "type": "string",
      "description": "ID del cliente en sistema anterior"
    },
    "legacy_series": {
      "type": "string",
      "description": "Serie del presupuesto en sistema anterior"
    },
    "legacy_raw_table": {
      "type": "string",
      "description": "Tabla de origen en sistema anterior"
    }
  },
  "required": [
    "cliente_id",
    "vehiculo_id",
    "servicios",
    "total"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "email": "mayaflamenco89@gmail.com"
          }
        },
        {
          "user_condition": {
            "email": "proautotallersv@gmail.com"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "email": "mayaflamenco89@gmail.com"
          }
        },
        {
          "user_condition": {
            "email": "proautotallersv@gmail.com"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "email": "mayaflamenco89@gmail.com"
          }
        },
        {
          "user_condition": {
            "email": "proautotallersv@gmail.com"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "email": "mayaflamenco89@gmail.com"
          }
        },
        {
          "user_condition": {
            "email": "proautotallersv@gmail.com"
          }
        }
      ]
    }
  }
}
