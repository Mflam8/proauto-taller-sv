{
  "name": "CatalogoPrecio",
  "type": "object",
  "properties": {
    "codigo_catalogo": {
      "type": "string",
      "description": "Número de ítem de la lista base"
    },
    "rubro": {
      "type": "string",
      "description": "Categoría del catálogo de precios"
    },
    "descripcion": {
      "type": "string",
      "description": "Descripción normalizada del servicio, artículo o material"
    },
    "precio_base": {
      "type": "number",
      "description": "Precio base sugerido desde el catálogo autorizado"
    },
    "precio_verificado": {
      "type": "number",
      "description": "Precio vigente confirmado por gerencia, si difiere"
    },
    "fuente": {
      "type": "string",
      "description": "Meses o referencia de respaldo en la lista"
    },
    "origen": {
      "type": "string",
      "description": "Archivo o fuente de importación"
    },
    "activo": {
      "type": "boolean",
      "default": true,
      "description": "Disponible para sugerir precios"
    }
  },
  "required": [
    "codigo_catalogo",
    "rubro",
    "descripcion",
    "precio_base"
  ],
