{
  "name": "Factura",
  "type": "object",
  "properties": {
    "numero_factura": {
      "type": "string",
      "description": "N\u00famero de factura"
    },
    "expediente_id": {
      "type": "string",
      "description": "ID del expediente asociado"
    },
    "orden_trabajo_id": {
      "type": "string",
      "description": "ID de orden de trabajo"
    },
    "cliente_id": {
      "type": "string",
      "description": "ID del cliente"
    },
    "vehiculo_id": {
      "type": "string",
      "description": "ID del veh\u00edculo"
    },
    "forma_pago": {
      "type": "string",
      "enum": [
        "Contado",
        "Cr\u00e9dito",
        "Mixto"
      ],
      "default": "Contado",
      "description": "Forma de pago general"
    },
    "aplica_iva": {
      "type": "boolean",
      "default": true,
      "description": "Si la factura aplica IVA (13%)"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "descripcion": {
            "type": "string"
          },
          "cantidad": {
            "type": "number"
          },
          "precio_unitario": {
            "type": "number"
          },
          "subtotal": {
            "type": "number"
          }
        }
      },
      "description": "Items facturados"
    },
    "subtotal": {
      "type": "number",
      "description": "Subtotal (Importe Bruto)"
    },
    "importe_neto": {
      "type": "number",
      "description": "Importe Neto antes de IVA"
    },
    "iva": {
      "type": "number",
      "description": "IVA aplicado (13%)"
    },
    "total": {
      "type": "number",
      "description": "Total de la factura"
    },
    "ganancia_mano_obra": {
      "type": "number",
      "default": 0,
      "description": "Ganancia neta del taller al emitir la factura: suma de los \u00edtems de mano de obra, excluyendo repuestos e insumos (gastos que se pagan a terceros)"
    },
    "estado_pago": {
      "type": "string",
      "enum": [
        "Pendiente",
        "Parcial",
        "Pagada",
        "Vencida",
        "Cerrada"
      ],
      "default": "Pendiente",
      "enumColors": [
        "yellow",
        "yellow",
        "green",
        "red",
        "gray"
      ],
      "description": "Estado del pago"
    },
    "motivo_cierre": {
      "type": "string",
      "description": "Motivo por el que se cerr\u00f3 la factura sin cobro completo"
    },
    "excepcion_recepcion_motivo": {
      "type": "string",
      "description": "Motivo de la excepci\u00f3n gerencial a la inspecci\u00f3n fotogr\u00e1fica"
    },
    "excepcion_recepcion_autorizada_por": {
      "type": "string",
      "description": "Correo de la persona de gerencia que autoriz\u00f3 la excepci\u00f3n"
    },
    "excepcion_recepcion_fecha": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha de autorizaci\u00f3n de la excepci\u00f3n"
    },
    "monto_pagado": {
      "type": "number",
      "default": 0,
      "description": "Monto ya pagado"
    },
    "saldo_pendiente": {
      "type": "number",
      "description": "Saldo pendiente"
    },
    "pago_lock_id": {
      "type": "string",
      "description": "Clave interna de coordinaci\u00f3n de cobros"
    },
    "pago_lock_token": {
      "type": "string",
      "description": "Bloqueo temporal interno durante el registro de un pago"
    },
    "pago_lock_hasta": {
      "type": "string",
      "format": "date-time",
      "description": "Vencimiento del bloqueo temporal de pago"
    },
    "fecha_vencimiento": {
      "type": "string",
      "format": "date",
      "description": "Fecha de vencimiento"
    },
    "fecha_emision": {
      "type": "string",
      "format": "date",
      "description": "Fecha de emisi\u00f3n de la factura"
    },
    "legacy_invoice_id": {
      "type": "string",
      "description": "ID de la factura en sistema anterior (DBF)"
    },
    "legacy_invoice_number": {
      "type": "string",
      "description": "N\u00famero de factura en sistema anterior"
    },
    "legacy_customer_id": {
      "type": "string",
      "description": "ID del cliente en sistema anterior"
    },
    "legacy_job_id": {
      "type": "string",
      "description": "ID del trabajo asociado en sistema anterior"
    },
    "legacy_series": {
      "type": "string",
      "description": "Serie de factura en sistema anterior"
    },
    "legacy_raw_table": {
      "type": "string",
      "description": "Tabla de origen en sistema anterior"
    }
  },
  "required": [
    "cliente_id",
    "items",
    "total"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "jefe_taller"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "jefe_taller"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "jefe_taller"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}