{
  "name": "TrabajoExpediente",
  "type": "object",
  "properties": {
    "expediente_id": {
      "type": "string",
      "description": "ID del expediente"
    },
    "descripcion": {
      "type": "string",
      "description": "Descripción del trabajo realizado"
    },
    "tecnico_id": {
      "type": "string",
      "description": "ID del técnico asignado"
    },
    "tecnico_nombre": {
      "type": "string",
      "description": "Nombre del técnico"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "Mano de Obra",
        "Mano de Obra Pintura",
        "Repuesto",
        "Insumo",
        "Diagnóstico",
        "Otro"
      ],
      "default": "Mano de Obra",
      "description": "Tipo de trabajo/ítem"
    },
    "cantidad": {
      "type": "number",
      "default": 1
    },
    "precio_unitario": {
      "type": "number",
      "default": 0
    },
    "subtotal": {
      "type": "number",
      "default": 0
    },
    "catalogo_precio_id": {
      "type": "string",
      "description": "Ítem del catálogo que originó la sugerencia"
    },
    "precio_sugerido": {
      "type": "number",
      "description": "Precio propuesto por la lista vigente"
    },
    "origen_precio": {
      "type": "string",
      "enum": [
        "Catálogo",
        "Manual"
      ],
      "description": "Cómo se obtuvo el precio sugerido"
    },
    "precio_ajustado_por": {
      "type": "string",
      "description": "Supervisor que modificó el precio sugerido"
    },
    "motivo_ajuste_precio": {
      "type": "string",
      "description": "Razón del ajuste de precio"
    },
    "fecha_ajuste_precio": {
      "type": "string",
      "format": "date-time"
    },
    "fecha_inicio": {
      "type": "string",
      "format": "date-time"
    },
    "fecha_fin": {
      "type": "string",
      "format": "date-time"
    },
    "evidencia_urls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "prueba_final": {
      "type": "string",
      "description": "Resultado de prueba de funcionamiento"
    },
    "estado": {
      "type": "string",
      "enum": [
        "Pendiente",
        "En Proceso",
        "Completado"
      ],
      "default": "Pendiente"
    },
    "aprobado_cliente": {
      "type": "boolean",
      "default": false
    },
    "notas": {
      "type": "string",
      "description": "Notas adicionales"
    }
  },
  "required": [
    "expediente_id",
    "descripcion",
    "tipo"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "email": "mayaflamenco89@gmail.com"
          }
        },
        {
          "user_condition": {
            "email": "proautotallersv@gmail.com"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "email": "mayaflamenco89@gmail.com"
          }
        },
        {
          "user_condition": {
            "email": "proautotallersv@gmail.com"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "email": "mayaflamenco89@gmail.com"
          }
        },
        {
          "user_condition": {
            "email": "proautotallersv@gmail.com"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "email": "mayaflamenco89@gmail.com"
          }
        },
        {
          "user_condition": {
            "email": "proautotallersv@gmail.com"
          }
        }
      ]
    }
  }
}
