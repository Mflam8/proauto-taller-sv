{
  "name": "TrabajoExpediente",
  "type": "object",
  "properties": {
    "expediente_id": {
      "type": "string",
      "description": "ID del expediente"
    },
    "descripcion": {
      "type": "string",
      "description": "Descripci\u00f3n del trabajo realizado"
    },
    "tecnico_id": {
      "type": "string",
      "description": "ID del t\u00e9cnico asignado"
    },
    "tecnico_nombre": {
      "type": "string",
      "description": "Nombre del t\u00e9cnico"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "Mano de Obra",
        "Mano de Obra Pintura",
        "Repuesto",
        "Insumo",
        "Diagn\u00f3stico",
        "Otro"
      ],
      "default": "Mano de Obra",
      "description": "Tipo de trabajo/\u00edtem"
    },
    "cantidad": {
      "type": "number",
      "default": 1
    },
    "precio_unitario": {
      "type": "number",
      "default": 0
    },
    "subtotal": {
      "type": "number",
      "default": 0
    },
    "catalogo_precio_id": {
      "type": "string",
      "description": "\u00cdtem del cat\u00e1logo que origin\u00f3 la sugerencia"
    },
    "precio_sugerido": {
      "type": "number",
      "description": "Precio propuesto por la lista vigente"
    },
    "origen_precio": {
      "type": "string",
      "enum": [
        "Cat\u00e1logo",
        "Manual"
      ],
      "description": "C\u00f3mo se obtuvo el precio sugerido"
    },
    "precio_ajustado_por": {
      "type": "string",
      "description": "Supervisor que modific\u00f3 el precio sugerido"
    },
    "motivo_ajuste_precio": {
      "type": "string",
      "description": "Raz\u00f3n del ajuste de precio"
    },
    "fecha_ajuste_precio": {
      "type": "string",
      "format": "date-time"
    },
    "fecha_inicio": {
      "type": "string",
      "format": "date-time"
    },
    "fecha_fin": {
      "type": "string",
      "format": "date-time"
    },
    "evidencia_urls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "prueba_final": {
      "type": "string",
      "description": "Resultado de prueba de funcionamiento"
    },
    "estado": {
      "type": "string",
      "enum": [
        "Pendiente",
        "En Proceso",
        "Completado"
      ],
      "default": "Pendiente"
    },
    "aprobado_cliente": {
      "type": "boolean",
      "default": false
    },
    "notas": {
      "type": "string",
      "description": "Notas adicionales"
    }
  },
  "required": [
    "expediente_id",
    "descripcion",
    "tipo"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}