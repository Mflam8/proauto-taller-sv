{
  "name": "MaterialTrabajo",
  "type": "object",
  "properties": {
    "expediente_id": {
      "type": "string",
      "description": "Expediente donde se utiliza o recibe el material"
    },
    "trabajo_id": {
      "type": "string",
      "description": "Trabajo técnico relacionado, si aplica"
    },
    "origen": {
      "type": "string",
      "enum": [
        "Inventario del taller",
        "Compra para este vehículo",
        "Proporcionado por el cliente"
      ],
      "description": "Origen del material"
    },
    "item_inventario_id": {
      "type": "string",
      "description": "Ítem de inventario cuando sale del taller"
    },
    "catalogo_precio_id": {
      "type": "string",
      "description": "Referencia al catálogo cuando aplica"
    },
    "descripcion": {
      "type": "string",
      "description": "Descripción del material o repuesto"
    },
    "numero_parte": {
      "type": "string",
      "description": "Número de parte o referencia"
    },
    "cantidad": {
      "type": "number",
      "default": 1
    },
    "costo_unitario": {
      "type": "number",
      "default": 0,
      "description": "Costo por unidad pagado por el taller"
    },
    "costo_total": {
      "type": "number",
      "default": 0,
      "description": "Costo total del material (cantidad × costo unitario)"
    },
    "proveedor_nombre": {
      "type": "string",
      "description": "Nombre del proveedor donde se compró el material"
    },
    "estado": {
      "type": "string",
      "enum": [
        "Recibida",
        "Instalada",
        "No utilizada",
        "Devuelta"
      ],
      "default": "Recibida"
    },
    "foto_urls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "proveedor_id": {
      "type": "string",
      "description": "Proveedor cuando se compra para este vehículo"
    },
    "comprobante_url": {
      "type": "string",
      "description": "Comprobante de compra, si existe"
    },
    "registrado_por": {
      "type": "string",
      "description": "Persona que registró el material"
    },
    "fecha_registro": {
      "type": "string",
      "format": "date-time"
    },
    "notas": {
      "type": "string"
    }
  },
  "required": [
    "expediente_id",
    "origen",
    "descripcion",
    "cantidad"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "email": "mayaflamenco89@gmail.com"
          }
        },
        {
          "user_condition": {
            "email": "proautotallersv@gmail.com"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "email": "mayaflamenco89@gmail.com"
          }
        },
        {
          "user_condition": {
            "email": "proautotallersv@gmail.com"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "email": "mayaflamenco89@gmail.com"
          }
        },
        {
          "user_condition": {
            "email": "proautotallersv@gmail.com"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "email": "mayaflamenco89@gmail.com"
          }
        },
        {
          "user_condition": {
            "email": "proautotallersv@gmail.com"
          }
        }
      ]
    }
  }
}
