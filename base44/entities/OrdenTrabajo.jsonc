{
  "name": "OrdenTrabajo",
  "type": "object",
  "properties": {
    "numero_orden": {
      "type": "string",
      "description": "Número único de orden"
    },
    "cotizacion_id": {
      "type": "string",
      "description": "ID de cotización asociada"
    },
    "cliente_id": {
      "type": "string",
      "description": "ID del cliente"
    },
    "vehiculo_id": {
      "type": "string",
      "description": "ID del vehículo"
    },
    "tecnico_asignado_id": {
      "type": "string",
      "description": "ID del técnico asignado"
    },
    "estado": {
      "type": "string",
      "enum": [
        "Recibido",
        "En Diagnóstico",
        "Esperando Repuestos",
        "En Reparación",
        "Control de Calidad",
        "Completado",
        "Entregado"
      ],
      "default": "Recibido",
      "description": "Estado actual"
    },
    "progreso_porcentaje": {
      "type": "number",
      "default": 0,
      "description": "Porcentaje de progreso"
    },
    "servicios_realizados": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "servicio": {
            "type": "string"
          },
          "fecha_inicio": {
            "type": "string",
            "format": "date-time"
          },
          "fecha_fin": {
            "type": "string",
            "format": "date-time"
          },
          "tecnico": {
            "type": "string"
          },
          "completado": {
            "type": "boolean"
          },
          "notas": {
            "type": "string"
          }
        }
      },
      "description": "Registro de servicios"
    },
    "fecha_entrada": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha de entrada al taller"
    },
    "fecha_estimada_entrega": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha estimada de entrega"
    },
    "fecha_entrega_real": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha real de entrega"
    },
    "kilometraje_entrada": {
      "type": "number",
      "description": "Kilometraje al entrar"
    },
    "notas_internas": {
      "type": "string",
      "description": "Notas internas del taller"
    },
    "legacy_job_id": {
      "type": "string",
      "description": "ID del trabajo en sistema anterior (DBF)"
    },
    "legacy_job_number": {
      "type": "string",
      "description": "Número de trabajo en sistema anterior"
    },
    "legacy_customer_id": {
      "type": "string",
      "description": "ID del cliente en sistema anterior"
    },
    "legacy_invoice_id": {
      "type": "string",
      "description": "ID de la factura asociada en sistema anterior"
    },
    "legacy_raw_table": {
      "type": "string",
      "description": "Tabla de origen en sistema anterior"
    }
  },
  "required": [
    "cliente_id",
    "vehiculo_id",
    "estado"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "email": "mayaflamenco89@gmail.com"
          }
        },
        {
          "user_condition": {
            "email": "proautotallersv@gmail.com"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "email": "mayaflamenco89@gmail.com"
          }
        },
        {
          "user_condition": {
            "email": "proautotallersv@gmail.com"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "email": "mayaflamenco89@gmail.com"
          }
        },
        {
          "user_condition": {
            "email": "proautotallersv@gmail.com"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "email": "mayaflamenco89@gmail.com"
          }
        },
        {
          "user_condition": {
            "email": "proautotallersv@gmail.com"
          }
        }
      ]
    }
  }
}
