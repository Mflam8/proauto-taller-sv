{
  "name": "Cliente",
  "type": "object",
  "properties": {
    "nombre_completo": {
      "type": "string",
      "description": "Nombre completo del cliente"
    },
    "telefono": {
      "type": "string",
      "description": "Número de teléfono"
    },
    "whatsapp": {
      "type": "string",
      "description": "Número de WhatsApp"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Correo electrónico"
    },
    "dui": {
      "type": "string",
      "description": "Número de DUI"
    },
    "nit": {
      "type": "string",
      "description": "Número de NIT"
    },
    "direccion": {
      "type": "string",
      "description": "Dirección completa"
    },
    "tipo_cliente": {
      "type": "string",
      "enum": [
        "Particular",
        "Empresa",
        "Aseguradora",
        "Flota"
      ],
      "default": "Particular",
      "description": "Tipo de cliente"
    },
    "nombre_empresa": {
      "type": "string",
      "description": "Nombre de la empresa (si aplica)"
    },
    "notas": {
      "type": "string",
      "description": "Observaciones adicionales sobre el cliente"
    },
    "activo": {
      "type": "boolean",
      "default": true,
      "description": "Si el cliente está activo"
    },
    "legacy_customer_id": {
      "type": "string",
      "description": "ID original del sistema anterior (DBF)"
    },
    "legacy_customer_code": {
      "type": "string",
      "description": "Código del cliente en sistema anterior"
    },
    "legacy_nombre_legal": {
      "type": "string",
      "description": "Nombre fiscal/legal del sistema anterior"
    },
    "legacy_saldo": {
      "type": "number",
      "description": "Saldo del cliente en sistema anterior"
    },
    "legacy_forma_pago": {
      "type": "string",
      "description": "Forma de pago del sistema anterior"
    },
    "legacy_raw_table": {
      "type": "string",
      "description": "Tabla de origen en sistema anterior"
    }
  },
  "required": [
    "nombre_completo",
    "telefono"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "email": "mayaflamenco89@gmail.com"
          }
        },
        {
          "user_condition": {
            "email": "proautotallersv@gmail.com"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "email": "mayaflamenco89@gmail.com"
          }
        },
        {
          "user_condition": {
            "email": "proautotallersv@gmail.com"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "email": "mayaflamenco89@gmail.com"
          }
        },
        {
          "user_condition": {
            "email": "proautotallersv@gmail.com"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "email": "mayaflamenco89@gmail.com"
          }
        },
        {
          "user_condition": {
            "email": "proautotallersv@gmail.com"
          }
        }
      ]
    }
  }
}
