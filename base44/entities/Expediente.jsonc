{
  "name": "Expediente",
  "type": "object",
  "properties": {
    "numero_expediente": {
      "type": "string",
      "description": "Número único del expediente (ej: EXP-2026-001)"
    },
    "cliente_id": {
      "type": "string",
      "description": "ID del cliente"
    },
    "vehiculo_id": {
      "type": "string",
      "description": "ID del vehículo"
    },
    "recibido_por_id": {
      "type": "string",
      "description": "ID del empleado que recibe"
    },
    "fecha_ingreso": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha y hora de ingreso"
    },
    "fecha_promesa_entrega": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha prometida de entrega"
    },
    "fecha_salida": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha y hora real de salida"
    },
    "kilometraje_entrada": {
      "type": "number",
      "description": "Kilometraje al ingresar"
    },
    "kilometraje_salida": {
      "type": "number",
      "description": "Kilometraje al salir"
    },
    "motivo_visita": {
      "type": "string",
      "description": "Motivo principal de la visita"
    },
    "sintomas_cliente": {
      "type": "string",
      "description": "Síntomas reportados por el cliente"
    },
    "indicaciones_cliente": {
      "type": "string",
      "description": "Indicaciones especiales del cliente"
    },
    "estado_interno": {
      "type": "string",
      "enum": [
        "Recibido",
        "En Diagnóstico",
        "Esperando Aprobación",
        "Aprobado",
        "En Reparación",
        "Esperando Repuesto",
        "En Pintura",
        "En Lavado",
        "Listo para Entrega",
        "Entregado",
        "Cerrado",
        "Cancelado"
      ],
      "default": "Recibido",
      "description": "Estado interno del expediente"
    },
    "estado_cliente": {
      "type": "string",
      "enum": [
        "En revisión",
        "En reparación",
        "Listo",
        "Entregado"
      ],
      "default": "En revisión",
      "description": "Estado visible para el cliente"
    },
    "llaves_cantidad": {
      "type": "number",
      "default": 1,
      "description": "Cantidad de llaves recibidas"
    },
    "llaves_observaciones": {
      "type": "string",
      "description": "Observaciones sobre las llaves"
    },
    "observaciones": {
      "type": "string",
      "description": "Observaciones generales"
    },
    "fotos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "URLs de fotos/videos del vehículo al ingresar"
    },
    "total_cobrado": {
      "type": "number",
      "default": 0,
      "description": "Total cobrado al cliente"
    },
    "total_pagado": {
      "type": "number",
      "default": 0,
      "description": "Total pagado hasta la fecha"
    },
    "saldo_pendiente": {
      "type": "number",
      "default": 0,
      "description": "Saldo pendiente de pago"
    },
    "trabajos_completados": {
      "type": "boolean",
      "default": false
    },
    "diagnostico_documentado": {
      "type": "boolean",
      "default": false
    },
    "evidencia_final": {
      "type": "boolean",
      "default": false
    },
    "factura_generada": {
      "type": "boolean",
      "default": false
    },
    "cierre_autorizado": {
      "type": "boolean",
      "default": false
    },
    "recepcion_cliente": {
      "type": "object",
      "description": "Conformidad de recepción del vehículo firmada por el cliente al retirarlo",
      "properties": {
        "vehiculo_recibido": {
          "type": "boolean",
          "description": "El cliente confirma haber recibido el vehículo"
        },
        "vehiculo_probado": {
          "type": "boolean",
          "description": "El cliente probó/manejó el vehículo y está satisfecho hasta ese momento"
        },
        "conforme_estado": {
          "type": "boolean",
          "description": "El cliente está conforme con el estado en que recibe el vehículo"
        },
        "fecha_recepcion": {
          "type": "string",
          "format": "date-time",
          "description": "Fecha y hora en que el cliente retiró el vehículo"
        },
        "nombre_firma": {
          "type": "string",
          "description": "Nombre de quien firma la recepción (cliente o representante)"
        },
        "firma_data_url": {
          "type": "string",
          "description": "Imagen de la firma capturada (data URL PNG)"
        },
        "metodo": {
          "type": "string",
          "enum": [
            "Digital",
            "Física"
          ],
          "description": "Método de captura de la firma"
        }
      }
    }
  },
  "required": [
    "cliente_id",
    "vehiculo_id",
    "motivo_visita"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "email": "mayaflamenco89@gmail.com"
          }
        },
        {
          "user_condition": {
            "email": "proautotallersv@gmail.com"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "email": "mayaflamenco89@gmail.com"
          }
        },
        {
          "user_condition": {
            "email": "proautotallersv@gmail.com"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "email": "mayaflamenco89@gmail.com"
          }
        },
        {
          "user_condition": {
            "email": "proautotallersv@gmail.com"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "email": "mayaflamenco89@gmail.com"
          }
        },
        {
          "user_condition": {
            "email": "proautotallersv@gmail.com"
          }
        }
      ]
    }
  }
}
