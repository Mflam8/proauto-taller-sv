{
  "name": "Inspeccion",
  "type": "object",
  "properties": {
    "expediente_id": {
      "type": "string",
      "description": "ID del expediente"
    },
    "vehiculo_id": {
      "type": "string",
      "description": "ID del vehículo"
    },
    "cliente_id": {
      "type": "string",
      "description": "ID del cliente"
    },
    "realizada_por": {
      "type": "string",
      "description": "Nombre del técnico que realiza"
    },
    "fecha": {
      "type": "string",
      "format": "date-time"
    },
    "kilometraje": {
      "type": "number"
    },
    "aseguradora": {
      "type": "string",
      "description": "Aseguradora asociada a esta recepción, si aplica"
    },
    "orden_trabajo_referencia": {
      "type": "string",
      "description": "Número de orden anotado al recibir"
    },
    "vehiculo_agencia_importado": {
      "type": "boolean",
      "default": false,
      "description": "Indica si el vehículo es de agencia o importado"
    },
    "tipo_croquis": {
      "type": "string",
      "enum": [
        "Sedán",
        "Pick-up",
        "Camioneta / SUV",
        "Camión",
        "Microbús",
        "Otro"
      ],
      "description": "Croquis usado para documentar daños"
    },
    "aire_acondicionado": {
      "type": "string",
      "enum": [
        "Funciona",
        "No funciona",
        "No aplica"
      ]
    },
    "direccion_hidraulica": {
      "type": "string",
      "enum": [
        "Sí",
        "No"
      ]
    },
    "alarma": {
      "type": "string",
      "enum": [
        "Sí",
        "No"
      ]
    },
    "estado_llantas": {
      "type": "string",
      "enum": [
        "Bueno",
        "Regular",
        "Malo"
      ]
    },
    "estado_luces": {
      "type": "string",
      "enum": [
        "Bueno",
        "Regular",
        "Malo"
      ]
    },
    "estado_vidrios": {
      "type": "string",
      "enum": [
        "Bueno",
        "Regular",
        "Malo"
      ]
    },
    "estado_pintura": {
      "type": "string",
      "enum": [
        "Bueno",
        "Regular",
        "Malo"
      ]
    },
    "estado_tapiceria": {
      "type": "string",
      "enum": [
        "Bueno",
        "Regular",
        "Malo"
      ]
    },
    "llanta_repuesto": {
      "type": "boolean",
      "default": false
    },
    "herramientas": {
      "type": "boolean",
      "default": false
    },
    "caja_herramientas": {
      "type": "boolean",
      "default": false,
      "description": "Caja de herramientas recibida"
    },
    "gato_mecanico": {
      "type": "boolean",
      "default": false,
      "description": "Gato mecánico recibido"
    },
    "cables_corriente": {
      "type": "boolean",
      "default": false,
      "description": "Cables de corriente recibidos"
    },
    "documentos": {
      "type": "boolean",
      "default": false
    },
    "accesorios_recibidos": {
      "type": "string",
      "description": "Lista de accesorios recibidos"
    },
    "evaluaciones": {
      "type": "array",
      "description": "Revisión detallada de elementos de carrocería, interior y sistemas",
      "items": {
        "type": "object",
        "properties": {
          "categoria": {
            "type": "string"
          },
          "elemento": {
            "type": "string"
          },
          "estado": {
            "type": "string"
          },
          "detalle": {
            "type": "string"
          }
        }
      }
    },
    "daños": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "tipo": {
            "type": "string",
            "enum": [
              "Rayón",
              "Golpe",
              "Quebrado",
              "Faltante",
              "Óxido",
              "Vidrio dañado",
              "Daño eléctrico",
              "Otro"
            ]
          },
          "ubicacion": {
            "type": "string"
          },
          "descripcion": {
            "type": "string"
          },
          "foto_url": {
            "type": "string"
          }
        }
      }
    },
    "fotos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "URLs de fotos de evidencia"
    },
    "firma_ingreso": {
      "type": "object",
      "description": "Confirmación del cliente al entregar el vehículo",
      "properties": {
        "nombre_firma": {
          "type": "string"
        },
        "firma_data_url": {
          "type": "string"
        },
        "fecha": {
          "type": "string",
          "format": "date-time"
        },
        "tecnico_nombre": {
          "type": "string"
        },
        "metodo": {
          "type": "string",
          "enum": [
            "Digital",
            "Física"
          ]
        }
      }
    },
    "observaciones": {
      "type": "string"
    },
    "estado": {
      "type": "string",
      "enum": [
        "Pendiente",
        "Completada"
      ],
      "default": "Pendiente"
    }
  },
  "required": [
    "expediente_id",
    "vehiculo_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "email": "mayaflamenco89@gmail.com"
          }
        },
        {
          "user_condition": {
            "email": "proautotallersv@gmail.com"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "email": "mayaflamenco89@gmail.com"
          }
        },
        {
          "user_condition": {
            "email": "proautotallersv@gmail.com"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "email": "mayaflamenco89@gmail.com"
          }
        },
        {
          "user_condition": {
            "email": "proautotallersv@gmail.com"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "email": "mayaflamenco89@gmail.com"
          }
        },
        {
          "user_condition": {
            "email": "proautotallersv@gmail.com"
          }
        }
      ]
    }
  }
}
