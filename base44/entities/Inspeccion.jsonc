{
  "name": "Inspeccion",
  "type": "object",
  "properties": {
    "expediente_id": {
      "type": "string",
      "description": "ID del expediente"
    },
    "vehiculo_id": {
      "type": "string",
      "description": "ID del veh\u00edculo"
    },
    "cliente_id": {
      "type": "string",
      "description": "ID del cliente"
    },
    "realizada_por": {
      "type": "string",
      "description": "Nombre del t\u00e9cnico que realiza"
    },
    "fecha": {
      "type": "string",
      "format": "date-time"
    },
    "kilometraje": {
      "type": "number"
    },
    "aseguradora": {
      "type": "string",
      "description": "Aseguradora asociada a esta recepci\u00f3n, si aplica"
    },
    "orden_trabajo_referencia": {
      "type": "string",
      "description": "N\u00famero de orden anotado al recibir"
    },
    "vehiculo_agencia_importado": {
      "type": "boolean",
      "default": false,
      "description": "Indica si el veh\u00edculo es de agencia o importado"
    },
    "tipo_croquis": {
      "type": "string",
      "enum": [
        "Sed\u00e1n",
        "Pick-up",
        "Camioneta / SUV",
        "Cami\u00f3n",
        "Microb\u00fas",
        "Otro"
      ],
      "description": "Croquis usado para documentar da\u00f1os"
    },
    "aire_acondicionado": {
      "type": "string",
      "enum": [
        "Funciona",
        "No funciona",
        "No aplica"
      ]
    },
    "direccion_hidraulica": {
      "type": "string",
      "enum": [
        "S\u00ed",
        "No"
      ]
    },
    "alarma": {
      "type": "string",
      "enum": [
        "S\u00ed",
        "No"
      ]
    },
    "estado_llantas": {
      "type": "string",
      "enum": [
        "Bueno",
        "Regular",
        "Malo"
      ]
    },
    "estado_luces": {
      "type": "string",
      "enum": [
        "Bueno",
        "Regular",
        "Malo"
      ]
    },
    "estado_vidrios": {
      "type": "string",
      "enum": [
        "Bueno",
        "Regular",
        "Malo"
      ]
    },
    "estado_pintura": {
      "type": "string",
      "enum": [
        "Bueno",
        "Regular",
        "Malo"
      ]
    },
    "estado_tapiceria": {
      "type": "string",
      "enum": [
        "Bueno",
        "Regular",
        "Malo"
      ]
    },
    "llanta_repuesto": {
      "type": "boolean",
      "default": false
    },
    "herramientas": {
      "type": "boolean",
      "default": false
    },
    "caja_herramientas": {
      "type": "boolean",
      "default": false,
      "description": "Caja de herramientas recibida"
    },
    "gato_mecanico": {
      "type": "boolean",
      "default": false,
      "description": "Gato mec\u00e1nico recibido"
    },
    "cables_corriente": {
      "type": "boolean",
      "default": false,
      "description": "Cables de corriente recibidos"
    },
    "documentos": {
      "type": "boolean",
      "default": false
    },
    "accesorios_recibidos": {
      "type": "string",
      "description": "Lista de accesorios recibidos"
    },
    "evaluaciones": {
      "type": "array",
      "description": "Revisi\u00f3n detallada de elementos de carrocer\u00eda, interior y sistemas",
      "items": {
        "type": "object",
        "properties": {
          "categoria": {
            "type": "string"
          },
          "elemento": {
            "type": "string"
          },
          "estado": {
            "type": "string"
          },
          "detalle": {
            "type": "string"
          }
        }
      }
    },
    "da\u00f1os": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "tipo": {
            "type": "string",
            "enum": [
              "Ray\u00f3n",
              "Golpe",
              "Quebrado",
              "Faltante",
              "\u00d3xido",
              "Vidrio da\u00f1ado",
              "Da\u00f1o el\u00e9ctrico",
              "Otro"
            ]
          },
          "ubicacion": {
            "type": "string"
          },
          "descripcion": {
            "type": "string"
          },
          "foto_url": {
            "type": "string"
          }
        }
      }
    },
    "fotos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "URLs de fotos de evidencia"
    },
    "firma_ingreso": {
      "type": "object",
      "description": "Confirmaci\u00f3n del cliente al entregar el veh\u00edculo",
      "properties": {
        "nombre_firma": {
          "type": "string"
        },
        "firma_data_url": {
          "type": "string"
        },
        "fecha": {
          "type": "string",
          "format": "date-time"
        },
        "tecnico_nombre": {
          "type": "string"
        },
        "metodo": {
          "type": "string",
          "enum": [
            "Digital",
            "F\u00edsica"
          ]
        }
      }
    },
    "observaciones": {
      "type": "string"
    },
    "estado": {
      "type": "string",
      "enum": [
        "Pendiente",
        "Completada"
      ],
      "default": "Pendiente"
    }
  },
  "required": [
    "expediente_id",
    "vehiculo_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}