{
  "name": "Pago",
  "type": "object",
  "properties": {
    "factura_id": {
      "type": "string",
      "description": "ID de la factura"
    },
    "monto": {
      "type": "number",
      "description": "Monto del pago"
    },
    "metodo_pago": {
      "type": "string",
      "enum": [
        "Efectivo",
        "Transferencia",
        "Tarjeta Débito",
        "Tarjeta Crédito",
        "Cheque"
      ],
      "description": "Método de pago"
    },
    "referencia": {
      "type": "string",
      "description": "Referencia del pago"
    },
    "fecha_pago": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha del pago"
    },
    "fecha_remesa": {
      "type": "string",
      "format": "date",
      "description": "Fecha de remesa/cheque (cuando se depositó al banco)"
    },
    "recibido_por": {
      "type": "string",
      "description": "Usuario que recibió el pago"
    },
    "notas": {
      "type": "string",
      "description": "Notas del pago"
    },
    "legacy_payment_id": {
      "type": "string",
      "description": "ID del cobro en sistema anterior (DBF)"
    },
    "legacy_invoice_id": {
      "type": "string",
      "description": "ID de la factura en sistema anterior"
    },
    "legacy_customer_id": {
      "type": "string",
      "description": "ID del cliente en sistema anterior"
    },
    "legacy_raw_table": {
      "type": "string",
      "description": "Tabla de origen en sistema anterior"
    }
  },
  "required": [
    "factura_id",
    "monto",
    "metodo_pago"
  ],
  "rls": {
    "create": {
      "$or": [
        {
