{
  "name": "Pago",
  "type": "object",
  "properties": {
    "factura_id": {
      "type": "string",
      "description": "ID de la factura"
    },
    "idempotencia_id": {
      "type": "string",
      "description": "Clave del env\u00edo para evitar registrar dos veces el mismo intento de pago"
    },
    "monto": {
      "type": "number",
      "description": "Monto del pago"
    },
    "metodo_pago": {
      "type": "string",
      "enum": [
        "Efectivo",
        "Transferencia",
        "Tarjeta D\u00e9bito",
        "Tarjeta Cr\u00e9dito",
        "Cheque"
      ]
    },
    "referencia": {
      "type": "string"
    },
    "fecha_pago": {
      "type": "string",
      "format": "date-time"
    },
    "fecha_remesa": {
      "type": "string",
      "format": "date"
    },
    "recibido_por": {
      "type": "string"
    },
    "notas": {
      "type": "string"
    },
    "legacy_payment_id": {
      "type": "string"
    },
    "legacy_invoice_id": {
      "type": "string"
    },
    "legacy_customer_id": {
      "type": "string"
    },
    "legacy_raw_table": {
      "type": "string"
    }
  },
  "required": [
    "factura_id",
    "monto",
    "metodo_pago"
  ],
  "rls": {
    "create": {
