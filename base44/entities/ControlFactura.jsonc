{
  "name": "ControlFactura",
  "type": "object",
  "properties": {
    "numero_control": {
      "type": "string",
      "description": "Número único de identidad del evento (ej: CT-2026-000001)"
    },
    "evento": {
      "type": "string",
      "enum": [
        "Creación",
        "Impresión"
      ],
      "description": "Tipo de evento registrado"
    },
    "factura_id": {
      "type": "string",
      "description": "ID de la factura"
    },
    "numero_factura": {
      "type": "string",
      "description": "Número de factura"
    },
    "cliente_nombre": {
      "type": "string",
      "description": "Nombre del cliente de la factura"
    },
    "vehiculo_desc": {
      "type": "string",
      "description": "Descripción del vehículo (marca y modelo)"
    },
    "expediente_id": {
      "type": "string",
      "description": "ID del expediente asociado"
    },
    "monto_total": {
      "type": "number",
      "default": 0,
      "description": "Total de la factura al momento del evento"
    },
    "usuario_email": {
      "type": "string",
      "description": "Correo del usuario que ejecutó el evento"
    },
    "usuario_nombre": {
      "type": "string",
      "description": "Nombre del usuario que ejecutó el evento"
    },
    "fecha_evento": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha y hora exacta del evento"
    }
  },
  "required": [
    "numero_control",
    "evento",
    "factura_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "email": "mayaflamenco89@gmail.com"
          }
        },
        {
          "user_condition": {
            "email": "proautotallersv@gmail.com"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "email": "mayaflamenco89@gmail.com"
          }
        },
        {
          "user_condition": {
            "email": "proautotallersv@gmail.com"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "email": "mayaflamenco89@gmail.com"
          }
        },
        {
          "user_condition": {
            "email": "proautotallersv@gmail.com"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "email": "mayaflamenco89@gmail.com"
          }
        },
        {
          "user_condition": {
            "email": "proautotallersv@gmail.com"
          }
        }
      ]
    }
  }
}
