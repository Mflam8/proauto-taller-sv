{
  "name": "Servicio",
  "type": "object",
  "properties": {
    "nombre": {
      "type": "string",
      "description": "Nombre del servicio"
    },
    "descripcion": {
      "type": "string",
      "description": "Descripción detallada"
    },
    "categoria": {
      "type": "string",
      "enum": [
        "Mecánica General",
        "Diagnóstico Computarizado",
        "Sistema de Frenos",
        "Mantenimiento GDI",
        "Avalúo",
        "Sistema Eléctrico",
        "Suspensión",
        "Transmisión",
        "Motor",
        "Otro"
      ],
      "description": "Categoría del servicio"
    },
    "precio_base": {
      "type": "number",
      "description": "Precio base estimado"
    },
    "tiempo_estimado_horas": {
      "type": "number",
      "description": "Tiempo estimado en horas"
    },
    "activo": {
      "type": "boolean",
      "default": true,
      "description": "Si el servicio está activo"
    },
    "legacy_item_id": {
      "type": "string",
      "description": "ID del artículo en sistema anterior (DBF)"
    },
    "legacy_code_family": {
      "type": "string",
      "description": "Código de familia en sistema anterior"
    },
    "legacy_barcode": {
      "type": "string",
      "description": "Código de barras en sistema anterior"
    },
    "legacy_precio_lista1": {
      "type": "number",
      "description": "Precio lista 1 del sistema anterior"
    },
    "legacy_raw_table": {
      "type": "string",
      "description": "Tabla de origen en sistema anterior"
    }
  },
  "required": [
    "nombre",
    "categoria",
    "precio_base"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "email": "mayaflamenco89@gmail.com"
          }
        },
        {
          "user_condition": {
            "email": "proautotallersv@gmail.com"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "email": "mayaflamenco89@gmail.com"
          }
        },
        {
          "user_condition": {
            "email": "proautotallersv@gmail.com"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "email": "mayaflamenco89@gmail.com"
          }
        },
        {
          "user_condition": {
            "email": "proautotallersv@gmail.com"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "email": "mayaflamenco89@gmail.com"
          }
        },
        {
          "user_condition": {
            "email": "proautotallersv@gmail.com"
          }
        }
      ]
    }
  }
}
