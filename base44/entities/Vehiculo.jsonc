{
  "name": "Vehiculo",
  "type": "object",
  "properties": {
    "cliente_id": {
      "type": "string",
      "description": "ID del cliente propietario"
    },
    "placa": {
      "type": "string",
      "description": "Número de placa (vacío o 'SIN PLACA' si el vehículo aún no placa)"
    },
    "poliza": {
      "type": "string",
      "description": "Número de póliza (obligatorio cuando el vehículo no tiene placa)"
    },
    "marca": {
      "type": "string",
      "description": "Marca del vehículo"
    },
    "modelo": {
      "type": "string",
      "description": "Modelo del vehículo"
    },
    "anio": {
      "type": "number",
      "description": "Año del vehículo"
    },
    "color": {
      "type": "string",
      "description": "Color del vehículo"
    },
    "vin": {
      "type": "string",
      "description": "Número VIN"
    },
    "tipo_vehiculo": {
      "type": "string",
      "enum": [
        "Sedán",
        "Pick-up",
        "SUV",
        "Camión",
        "Motocicleta",
        "Van",
        "Otro"
      ],
      "description": "Tipo de vehículo"
    },
    "motor": {
      "type": "string",
      "description": "Tipo/código de motor"
    },
    "cilindrada": {
      "type": "string",
      "description": "Cilindrada del motor (ej: 1.6L, 2.0L)"
    },
    "tipo_combustible": {
      "type": "string",
      "enum": [
        "Gasolina",
        "Diesel",
        "Híbrido",
        "Eléctrico"
      ],
      "description": "Tipo de combustible"
    },
    "kilometraje_actual": {
      "type": "number",
      "description": "Kilometraje actual"
    },
    "estado_actual": {
      "type": "string",
      "enum": [
        "En taller",
        "Listo",
        "Entregado",
        "Fuera del taller"
      ],
      "default": "Fuera del taller",
      "description": "Estado actual del vehículo"
    },
    "fotos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "URLs de fotos del vehículo"
    },
    "notas": {
      "type": "string",
      "description": "Notas adicionales"
    }
  },
  "required": [
    "cliente_id",
    "marca",
    "modelo"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "email": "mayaflamenco89@gmail.com"
          }
        },
        {
          "user_condition": {
            "email": "proautotallersv@gmail.com"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "email": "mayaflamenco89@gmail.com"
          }
        },
        {
          "user_condition": {
            "email": "proautotallersv@gmail.com"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "email": "mayaflamenco89@gmail.com"
          }
        },
        {
          "user_condition": {
            "email": "proautotallersv@gmail.com"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "email": "mayaflamenco89@gmail.com"
          }
        },
        {
          "user_condition": {
            "email": "proautotallersv@gmail.com"
          }
        }
      ]
    }
  }
}
