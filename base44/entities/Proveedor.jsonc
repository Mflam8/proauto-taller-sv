{
  "name": "Proveedor",
  "type": "object",
  "properties": {
    "nombre": {
      "type": "string",
      "description": "Nombre del proveedor"
    },
    "contacto_principal": {
      "type": "string",
      "description": "Nombre del contacto"
    },
    "telefono": {
      "type": "string",
      "description": "Teléfono"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Email"
    },
    "direccion": {
      "type": "string",
      "description": "Dirección"
    },
    "productos_suministrados": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Tipos de productos que suministra"
    },
    "terminos_pago": {
      "type": "string",
      "description": "Términos de pago"
    },
    "notas": {
      "type": "string",
      "description": "Notas adicionales"
    },
    "activo": {
      "type": "boolean",
      "default": true,
      "description": "Si el proveedor está activo"
    }
  },
  "required": [
    "nombre",
    "telefono"
  ],
  "rls": {
    "create": {
