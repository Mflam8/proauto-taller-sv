{
  "name": "Diagnostico",
  "type": "object",
  "properties": {
    "expediente_id": {
      "type": "string",
      "description": "ID del expediente"
    },
    "vehiculo_id": {
      "type": "string",
      "description": "ID del vehículo"
    },
    "tecnico_id": {
      "type": "string",
      "description": "ID del empleado técnico"
    },
    "tecnico_nombre": {
      "type": "string",
      "description": "Nombre del técnico"
    },
    "fecha": {
      "type": "string",
      "format": "date-time"
    },
    "diagnostico_inicial": {
      "type": "string",
      "description": "Diagnóstico inicial"
    },
    "diagnostico_final": {
      "type": "string",
      "description": "Diagnóstico final confirmado"
    },
    "fallas_detectadas": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sistema": {
            "type": "string"
          },
          "descripcion": {
            "type": "string"
          },
          "severidad": {
            "type": "string",
            "enum": [
              "Leve",
              "Moderada",
              "Grave",
              "Crítica"
            ]
          }
        }
      }
    },
    "recomendaciones": {
      "type": "string"
    },
    "fotos": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "estado": {
      "type": "string",
      "enum": [
        "Pendiente",
        "En Proceso",
        "Completado"
      ],
      "default": "Pendiente"
    }
  },
  "required": [
    "expediente_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "email": "mayaflamenco89@gmail.com"
          }
        },
        {
          "user_condition": {
            "email": "proautotallersv@gmail.com"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "email": "mayaflamenco89@gmail.com"
          }
        },
        {
          "user_condition": {
            "email": "proautotallersv@gmail.com"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "email": "mayaflamenco89@gmail.com"
          }
        },
        {
          "user_condition": {
            "email": "proautotallersv@gmail.com"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "email": "mayaflamenco89@gmail.com"
          }
        },
        {
          "user_condition": {
            "email": "proautotallersv@gmail.com"
          }
        }
      ]
    }
  }
}
