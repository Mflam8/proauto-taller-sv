{
  "name": "Gasto",
  "type": "object",
  "properties": {
    "categoria": {
      "type": "string",
      "enum": [
        "Gasto de Taller",
        "Servicio del Local",
        "Suministros y Limpieza",
        "Otro"
      ],
      "description": "Categor\u00eda del gasto: repuestos, servicios del local (TIGO, agua, luz, alquiler) o suministros (papel, caf\u00e9, az\u00facar)"
    },
    "concepto": {
      "type": "string",
      "description": "Descripci\u00f3n de lo comprado o pagado"
    },
    "proveedor": {
      "type": "string",
      "description": "Proveedor o beneficiario del gasto"
    },
    "monto": {
      "type": "number",
      "description": "Monto total del gasto"
    },
    "forma_pago": {
      "type": "string",
      "enum": [
        "Contado",
        "Cr\u00e9dito"
      ],
      "default": "Contado",
      "description": "Contado se paga de inmediato; cr\u00e9dito queda con saldo pendiente hasta abonarse"
    },
    "metodo_pago": {
      "type": "string",
      "enum": [
        "Efectivo",
        "Transferencia",
        "Tarjeta D\u00e9bito",
        "Tarjeta Cr\u00e9dito",
        "Cheque"
      ],
      "description": "Medio con que se pag\u00f3 (compra de contado o abonos)"
    },
    "numero_factura": {
      "type": "string",
      "description": "N\u00famero de factura o recibo del proveedor"
    },
    "fecha_compra": {
      "type": "string",
      "format": "date",
      "description": "Fecha de compra o de la factura"
    },
    "expediente_id": {
      "type": "string",
      "description": "Expediente del veh\u00edculo asociado (si aplica, ej: repuestos de un trabajo)"
    },
    "monto_pagado": {
      "type": "number",
      "default": 0,
      "description": "Monto ya pagado"
    },
    "saldo_pendiente": {
      "type": "number",
      "default": 0,
      "description": "Saldo pendiente (compras al cr\u00e9dito)"
    },
    "estado_pago": {
      "type": "string",
      "enum": [
        "Pendiente",
        "Parcial",
        "Pagada"
      ],
      "default": "Pendiente",
      "description": "Estado del pago del gasto"
    },
    "pagos": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "fecha_pago": {
            "type": "string",
            "format": "date-time"
          },
          "monto": {
            "type": "number"
          },
          "metodo_pago": {
            "type": "string"
          },
          "referencia": {
            "type": "string"
          }
        }
      },
      "description": "Historial de pagos con su fecha (fecha en que sali\u00f3 de caja)"
    },
    "notas": {
      "type": "string",
      "description": "Observaciones"
    }
  },
  "required": [
    "categoria",
    "concepto",
    "monto",
    "fecha_compra"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "email": "proautotallersv@gmail.com"
          }
        },
        {
          "user_condition": {
            "email": "mayaflamenco89@gmail.com"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "email": "proautotallersv@gmail.com"
          }
        },
        {
          "user_condition": {
            "email": "mayaflamenco89@gmail.com"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "email": "proautotallersv@gmail.com"
          }
        },
        {
          "user_condition": {
            "email": "mayaflamenco89@gmail.com"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "email": "proautotallersv@gmail.com"
          }
        },
        {
          "user_condition": {
            "email": "mayaflamenco89@gmail.com"
          }
        }
      ]
    }
  }
}