{
  "name": "ItemInventario",
  "type": "object",
  "properties": {
    "codigo": {
      "type": "string",
      "description": "Código único del item"
    },
    "nombre": {
      "type": "string",
      "description": "Nombre del item"
    },
    "descripcion": {
      "type": "string",
      "description": "Descripción detallada"
    },
    "categoria": {
      "type": "string",
      "enum": [
        "Repuestos",
        "Aceites y Lubricantes",
        "Filtros",
        "Frenos",
        "Suspensión",
        "Sistema Eléctrico",
        "Herramientas",
        "Insumos",
        "Otro"
      ],
      "description": "Categoría del item"
    },
    "stock_actual": {
      "type": "number",
      "default": 0,
      "description": "Cantidad actual en stock"
    },
    "stock_minimo": {
      "type": "number",
      "default": 5,
      "description": "Stock mínimo para alerta"
    },
    "precio_compra": {
      "type": "number",
      "description": "Precio de compra unitario"
    },
    "precio_venta": {
      "type": "number",
      "description": "Precio de venta unitario"
    },
    "proveedor_principal": {
      "type": "string",
      "description": "ID del proveedor principal"
    },
    "ubicacion_fisica": {
      "type": "string",
      "description": "Ubicación en el taller"
    },
    "activo": {
      "type": "boolean",
      "default": true,
      "description": "Si el item está activo"
    }
  },
  "required": [
    "nombre",
    "categoria",
    "stock_actual"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "email": "mayaflamenco89@gmail.com"
          }
        },
        {
          "user_condition": {
            "email": "proautotallersv@gmail.com"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "email": "mayaflamenco89@gmail.com"
          }
        },
        {
          "user_condition": {
            "email": "proautotallersv@gmail.com"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
