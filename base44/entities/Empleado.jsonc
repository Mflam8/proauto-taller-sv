{
  "name": "Empleado",
  "type": "object",
  "properties": {
    "nombre_completo": {
      "type": "string",
      "description": "Nombre completo del empleado"
    },
    "telefono": {
      "type": "string",
      "description": "Tel\u00e9fono de contacto"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Correo electr\u00f3nico"
    },
    "cargo": {
      "type": "string",
      "description": "Cargo o puesto"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "Recepci\u00f3n",
        "T\u00e9cnico",
        "Administraci\u00f3n",
        "Gerencia",
        "Carwash",
        "Pintura",
        "Otro"
      ],
      "description": "Tipo de rol en el taller"
    },
    "perfil_acceso": {
      "type": "string",
      "enum": [
        "sin_acceso",
        "admin",
        "tecnico",
        "pintura"
      ],
      "default": "sin_acceso",
      "description": "Perfil de acceso: SUPER ADMIN se reconoce por correo, aqu\u00ed solo sin_acceso, admin, t\u00e9cnico de mec\u00e1nica o t\u00e9cnico de pintura"
    },
    "capacidades": {
      "type": "object",
      "description": "Interruptores individuales de capacidades (solo SUPER ADMIN los cambia)"
    },
    "especialidad": {
      "type": "string",
      "description": "Especialidad t\u00e9cnica (si aplica)"
    },
    "fecha_ingreso": {
      "type": "string",
      "format": "date",
      "description": "Fecha de ingreso al taller"
    },
    "fecha_nacimiento": {
      "type": "string",
      "format": "date",
      "description": "Fecha de nacimiento (cumplea\u00f1os)"
    },
    "dui": {
      "type": "string",
      "description": "N\u00famero de DUI"
    },
    "activo": {
      "type": "boolean",
      "default": true,
      "description": "Si el empleado est\u00e1 activo"
    },
    "notas": {
      "type": "string",
      "description": "Observaciones"
    }
  },
  "required": [
    "nombre_completo",
    "tipo"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "jefe_taller"
          }
        },
        {
          "user_condition": {
            "role": "tecnico"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}