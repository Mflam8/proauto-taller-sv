{
  "name": "Empleado",
  "type": "object",
  "properties": {
    "nombre_completo": {
      "type": "string",
      "description": "Nombre completo del empleado"
    },
    "telefono": {
      "type": "string",
      "description": "Teléfono de contacto"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Correo electrónico"
    },
    "cargo": {
      "type": "string",
      "description": "Cargo o puesto"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "Recepción",
        "Técnico",
        "Administración",
        "Gerencia",
        "Carwash",
        "Pintura",
        "Otro"
      ],
      "description": "Tipo de rol en el taller"
    },
    "especialidad": {
      "type": "string",
      "description": "Especialidad técnica (si aplica)"
    },
    "fecha_ingreso": {
      "type": "string",
      "format": "date",
      "description": "Fecha de ingreso al taller"
    },
    "fecha_nacimiento": {
      "type": "string",
      "format": "date",
      "description": "Fecha de nacimiento (cumpleaños)"
    },
    "dui": {
      "type": "string",
      "description": "Número de DUI"
    },
    "activo": {
      "type": "boolean",
      "default": true,
      "description": "Si el empleado está activo"
    },
    "notas": {
      "type": "string",
      "description": "Observaciones"
    },
    "perfil_acceso": {
      "type": "string",
      "enum": [
        "sin_acceso",
        "tecnico",
        "pintura",
        "jefe_taller",
        "recepcion_cobros"
      ],
      "default": "sin_acceso",
      "description": "Perfil operativo seleccionado por gerencia; independiente del cargo y tipo de empleado."
    }
  },
  "required": [
    "nombre_completo",
    "tipo"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "email": "mayaflamenco89@gmail.com"
          }
        },
        {
          "user_condition": {
            "email": "proautotallersv@gmail.com"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "email": "mayaflamenco89@gmail.com"
          }
        },
        {
          "user_condition": {
            "email": "proautotallersv@gmail.com"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "email": "mayaflamenco89@gmail.com"
          }
        },
        {
          "user_condition": {
            "email": "proautotallersv@gmail.com"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "email": "mayaflamenco89@gmail.com"
          }
        },
        {
          "user_condition": {
            "email": "proautotallersv@gmail.com"
          }
        }
      ]
    }
  }
}
